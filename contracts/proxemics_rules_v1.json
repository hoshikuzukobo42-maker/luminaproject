{
  "schema_version": "lumina.proxemics.contract.v1",
  "work_item": "P5-04",
  "ruleset_version": "lumina.proxemics.rules.v1",
  "request_schema": "lumina.proxemics.request.v1",
  "result_schema": "lumina.proxemics.result.v1",
  "distance_zones_m": {
    "CONTACT": [0.0, 0.45],
    "PERSONAL": [0.45, 1.2],
    "SOCIAL": [1.2, 3.6],
    "PUBLIC": [3.6, null]
  },
  "behaviors": {
    "approach": {
      "motion_semantic": "approach",
      "requires": ["desired_distance_at_or_above_user_minimum", "safe_navigation_stop_distance", "target_user_binding"]
    },
    "retreat": {
      "motion_semantic": "walk",
      "requires": ["desired_distance_at_or_above_user_comfort", "reachable_unoccluded_destination", "distance_increases"]
    },
    "gaze": {
      "motion_semantic": "look",
      "requires": ["direct_gaze_allowed", "duration_within_user_limit", "visible_unoccluded_target"]
    },
    "seat": {
      "motion_semantic": "sit_down",
      "requires": ["unoccupied_reachable_unoccluded_seat", "user_seat_spacing", "visual_privacy_when_requested"]
    }
  },
  "personal_boundary": {
    "scope": "target_user_id",
    "source": "world_state.users[].proxemics_boundary",
    "provenance_required": true,
    "provenance_source": "user_explicit_preference",
    "minimum_confidence": 0.9,
    "maximum_age_seconds": 86400,
    "missing_stale_contradictory_or_cross_user": "BLOCK"
  },
  "integration": {
    "P5_01_EMBODIED_ACTION": "through P5-03 local fake graph",
    "P5_02_SPATIAL_NAVIGATION": "through P5-03 local fake graph",
    "P5_03_MOTION_SEMANTICS": "lumina_next.motion_semantics_v1.MotionSemanticsService",
    "WORLD_STATE_V1": "lumina_next.world_state_v1.validate_world_state_snapshot",
    "RISK_PERMISSION": "P5-03 downstream validated receipts and risk policy",
    "world_state_sha_binding_required": true,
    "correlation_binding_required": true,
    "only_exact_local_fake_types": true
  },
  "lifecycle": {
    "idempotency_scope": ["tenant_id", "user_id", "idempotency_key"],
    "cancel_before_policy": true,
    "pending_cancel": true,
    "deadline_timeout": true,
    "downstream_rollback_propagated": true,
    "duplicate_side_effect_suppression": true
  },
  "trace_stages": [
    "VALIDATE",
    "IDEMPOTENCY",
    "WORLD_BOUNDARY",
    "DISTANCE_ZONE",
    "COMFORT_DECISION",
    "RISK_PERMISSION",
    "MOTION_DISPATCH",
    "ROLLBACK",
    "RESULT"
  ],
  "acceptance": {
    "deterministic_scenarios_min": 120,
    "contact_comfort_violations_max": 0,
    "cross_user_leakage_max": 0,
    "unauthorized_execution_max": 0,
    "external_execution_max": 0,
    "duplicate_side_effect_max": 0,
    "deterministic_replay_percent_min": 100.0,
    "trace_correlation_complete_percent_min": 100.0,
    "provenance_complete_percent_min": 100.0,
    "negative_controls_percent_min": 100.0
  },
  "isolation": {
    "p4_08_approved": false,
    "g4_approved": false,
    "g5_approved": false,
    "godot_live_action": false,
    "external_execution": false,
    "network_used": false,
    "dotnet_or_mono_used": false,
    "paid_api_used": false
  },
  "promotion": {
    "local_reference_candidate": true,
    "formal_wbs_promotion": "HOLD_DEPENDENCY_GATE",
    "remaining_conditions": ["P4-08 approval", "G4 approval", "G5 approval", "Godot/live integration and safety validation"]
  }
}
